# CMake Build Directories & Files
# Anchored: an unanchored "archive/" also matches source directories at any depth, which silently
# excluded cli/toob-cli/internal/archiveutil's predecessor from version control.
/archive/
builds/
/build/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
compile_commands.json

# Tooling & Editor Cache
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python (Manifest Compiler / Scripts)
__pycache__/
*.pyc

# Third Party / Fetch Content (Optional if we use ccache or external downloads)
_deps/
.cache/

# Test Artifacts / Coverage
coverage/
*.gcda
*.gcno

# lockfiles
**/toob.lock

# local utility repos
.release-repo/

# Export Scripts and Review Files
/*.ps1
scripts/export_*.ps1
*_review_export.txt
cli/.pipeline-repo/
.secrets

# Third-party libraries

# CLI Build Artifacts
/toob.exe
/toob
cli/toob-cli/toob.exe
cli/toob-cli/toob

cli_export.txt
full_review_export.txt
mock_efuse.o
# Toob-Loader Spawned HALs
toobloader/hal/

# Local scratch, bringup & secrets (never commit)
/.gemini_scratch/
/scratch/
/test/test_c6_bringup/
/wifi.txt

# Rocq / Coq compiled artifacts & tactic caches
*.vo
*.vok
*.vos
*.glob
.*.aux
