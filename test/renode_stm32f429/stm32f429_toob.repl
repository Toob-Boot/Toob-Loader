nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    -> cpu@0
    SystemResetRequest -> rcc@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x30000

ccm: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

syscfg: Miscellaneous.Stm32F429Syscfg @ sysbus 0x40013800

bootAlias: Miscellaneous.Stm32F429BootAlias @ sysbus 0x00000000
    flash: flash
    syscfg: syscfg

otp: Miscellaneous.Stm32F429OtpUid @ sysbus 0x1FFF7800

pwr: Miscellaneous.Stm32F429Pwr @ sysbus 0x40007000

rtc: Miscellaneous.Stm32F429RtcBkp @ sysbus 0x40002800
    pwr: pwr

rcc: Miscellaneous.Stm32F429Rcc @ sysbus 0x40023800

iwdg: Miscellaneous.Stm32F429Iwdg @ sysbus 0x40003000
    rcc: rcc

usart1: UART.STM32_UART @ sysbus <0x40011000, +0x100>
    -> nvic@37

rng: Miscellaneous.Stm32F429Rng @ sysbus 0x50060800

flashCtrl: Miscellaneous.Stm32F429FlashController @ sysbus 0x40023C00
    flash: flash
    otp: otp
    syscfg: syscfg
