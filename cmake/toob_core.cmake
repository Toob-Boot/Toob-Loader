# ==============================================================================
# Submodule: toob_core (Hardware-Agnostic Bootloader Core)
# 
# Relevant Specs: 
# - docs/concept_fusion.md (Layer 3: Core Engine, Layer 4b: Diagnostics)
# - docs/structure_plan.md (Directory tree `toobloader/core/`)
# - docs/merkle_spec.md (Chunk-based Verification)
# - docs/stage_1_5_spec.md (UART Recovery)
# - docs/wal_internals.md (Write-Ahead Log)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vendored Third-Party Libraries
# ------------------------------------------------------------------------------
# Isolate third-party code into dedicated static targets so strict P10 `-Werror`
# flags on first-party targets do not break external implementations.

# heatshrink (ISC License)
add_library(toob_heatshrink STATIC 
    common/lib/heatshrink/heatshrink_decoder.c
)
# Disable dynamic allocation so heatshrink never calls malloc under P10 rules.
target_compile_definitions(toob_heatshrink PUBLIC 
    HEATSHRINK_DYNAMIC_ALLOC=0 
    HEATSHRINK_STATIC_INPUT_BUFFER_SIZE=128 
    HEATSHRINK_STATIC_WINDOW_BITS=8 
    HEATSHRINK_STATIC_LOOKAHEAD_BITS=4
)
target_compile_options(toob_heatshrink PRIVATE -Os -ffunction-sections -fdata-sections)
target_include_directories(toob_heatshrink PUBLIC common/lib/heatshrink)

# ------------------------------------------------------------------------------
# 2. Toob-Boot Core (State Machine)
# ------------------------------------------------------------------------------

# Verify generated manifest artifacts exist before compiling dependent targets.
add_custom_command(
    OUTPUT ${CMAKE_BINARY_DIR}/generated/generated_boot_config.h
           ${CMAKE_BINARY_DIR}/generated/stage0_layout.ld
    COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_BINARY_DIR}/generated
    COMMAND ${CMAKE_COMMAND} -E echo "Manifests generated by Toob CLI"
    COMMENT "Verifying generated manifest artifacts..."
)

add_custom_target(generate_manifest
    DEPENDS ${CMAKE_BINARY_DIR}/generated/generated_boot_config.h
            ${CMAKE_BINARY_DIR}/generated/stage0_layout.ld
)


# Double-execution of Ed25519 verification defaults ON for fault-injection resistance.
if(NOT DEFINED TOOB_DOUBLE_VERIFY)
    option(TOOB_DOUBLE_VERIFY "Enable double-execution of Ed25519 verification for fault resistance" ON)
endif()

# ------------------------------------------------------------------------------
# 2a. Toob-Boot Utilities (Algorithms & Helper Modules)
# ------------------------------------------------------------------------------
# Standalone utility modules (CRC32, COBS framing, Merkle streaming, WDT delay,
# diagnostics, energy model, identity KDF, secure zeroize).

set(TOOB_UTILS_DIR ${TOOB_CORE_DIR}/utils)

add_library(toob_utils STATIC
    ${TOOB_UTILS_DIR}/boot_cobs.c
    ${TOOB_UTILS_DIR}/boot_crc32.c
    ${TOOB_UTILS_DIR}/boot_delay.c
    ${TOOB_UTILS_DIR}/boot_diag.c
    ${TOOB_UTILS_DIR}/boot_energy.c
    ${TOOB_UTILS_DIR}/boot_identity.c
    ${TOOB_UTILS_DIR}/boot_merkle.c
)

# Host SIL uses the portable C zeroize implementation instead of bare-metal ASM.
if(NOT TOOB_ARCH STREQUAL "host")
    target_sources(toob_utils PRIVATE ${TOOB_UTILS_DIR}/boot_secure_zeroize.S)
else()
    target_sources(toob_utils PRIVATE ${TOOB_UTILS_DIR}/boot_secure_zeroize_host.c)
endif()

target_include_directories(toob_utils PUBLIC
    ${CMAKE_SOURCE_DIR}/common/include
    ${TOOB_UTILS_DIR}/include
    ${TOOB_CORE_DIR}/include
    ${CMAKE_BINARY_DIR}/generated
    ${TOOB_SDK_DIR}/libtoob/include
)

toob_apply_strict_flags(toob_utils TRUE)
add_dependencies(toob_utils generate_manifest)
if(TOOB_ARCH STREQUAL "host")
    target_compile_definitions(toob_utils PUBLIC TOOB_MOCK_TEST)
endif()

if(TOOB_DOUBLE_VERIFY)
    target_compile_definitions(toob_utils PRIVATE TOOB_DOUBLE_VERIFY=1)
else()
    target_compile_definitions(toob_utils PRIVATE TOOB_DOUBLE_VERIFY=0)
endif()

# ------------------------------------------------------------------------------
# 2b. Toob-Boot Core (Boot Pipeline & State Machine)
# ------------------------------------------------------------------------------
# Boot pipeline, WAL journal, image swapping, delta patching, crypto verification,
# rollback protection, cloud commands, provisioning, panic/recovery.

add_library(toob_core STATIC
    ${TOOB_CORE_DIR}/boot_state.c
    ${TOOB_CORE_DIR}/boot_mailbox.c
    ${TOOB_CORE_DIR}/boot_tbm1.c
    ${TOOB_CORE_DIR}/boot_effect.c
    ${TOOB_CORE_DIR}/boot_journal.c
    ${TOOB_CORE_DIR}/boot_verify.c
    ${TOOB_CORE_DIR}/boot_swap.c
    ${TOOB_CORE_DIR}/boot_delta.c
    ${TOOB_CORE_DIR}/boot_decomp.c
    ${TOOB_CORE_DIR}/boot_rollback.c
    ${TOOB_CORE_DIR}/boot_panic.c
    ${TOOB_CORE_DIR}/boot_provisioning.c
    ${TOOB_CORE_DIR}/boot_confirm.c
    ${TOOB_CORE_DIR}/boot_multiimage.c
    ${TOOB_CORE_DIR}/boot_cloud_cmd.c
    ${TOOB_CORE_DIR}/boot_rstore.c
    ${TOOB_CORE_DIR}/boot_transport.c
    ${TOOB_CORE_DIR}/boot_transport_swapscratch.c
    ${TOOB_CORE_DIR}/boot_transport_oneway.c
    ${TOOB_CORE_DIR}/boot_transport_swapmove.c
    ${TOOB_CORE_DIR}/boot_transport_pointer.c
    ${TOOB_CORE_DIR}/boot_platform_bringup.c
)

# Wait for generated headers before compiling core translation units in parallel builds.
add_dependencies(toob_core generate_manifest)

if(TOOB_ARCH STREQUAL "host")
    target_compile_definitions(toob_core PUBLIC TOOB_MOCK_TEST)
endif()

if(TOOB_DOUBLE_VERIFY)
    target_compile_definitions(toob_core PRIVATE TOOB_DOUBLE_VERIFY=1)
else()
    target_compile_definitions(toob_core PRIVATE TOOB_DOUBLE_VERIFY=0)
endif()

# ------------------------------------------------------------------------------
# 3. Include Paths, Linking & Hardening
# ------------------------------------------------------------------------------

target_include_directories(toob_core PUBLIC
    ${CMAKE_BINARY_DIR}/generated
    ${CMAKE_SOURCE_DIR}/common/include
    ${TOOB_CORE_DIR}/include
    ${TOOB_UTILS_DIR}/include
    ${TOOB_SDK_DIR}/libtoob/include
)

target_link_libraries(toob_core PRIVATE toob_heatshrink toob_utils)

# Apply strict P10 flags including -fstack-protector-strong on core translation units.
toob_apply_strict_flags(toob_core TRUE)

# Single-compile Stage 1 entrypoint object shared by toob_stage1, toob_stage1b, and host SIL
add_library(toob_stage1_entry OBJECT
    ${TOOB_CORE_DIR}/boot_main.c
)
add_dependencies(toob_stage1_entry generate_manifest)
if(TOOB_ARCH STREQUAL "host")
    target_compile_definitions(toob_stage1_entry PUBLIC TOOB_MOCK_TEST)
endif()
if(TOOB_DOUBLE_VERIFY)
    target_compile_definitions(toob_stage1_entry PRIVATE TOOB_DOUBLE_VERIFY=1)
else()
    target_compile_definitions(toob_stage1_entry PRIVATE TOOB_DOUBLE_VERIFY=0)
endif()
target_include_directories(toob_stage1_entry PUBLIC
    ${CMAKE_BINARY_DIR}/generated
    ${CMAKE_SOURCE_DIR}/common/include
    ${TOOB_CORE_DIR}/include
    ${TOOB_UTILS_DIR}/include
    ${TOOB_SDK_DIR}/libtoob/include
)
toob_apply_strict_flags(toob_stage1_entry TRUE)
